POSTGRES_USER=tracker
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=tracker
DATABASE_URL=postgresql+psycopg://tracker:local-development-only@localhost:5432/tracker
ENVIRONMENT=development

SESSION_TTL_HOURS=24
AUTH_RATE_LIMIT=20
